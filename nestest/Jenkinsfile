pipeline {
    agent any

    environment {
        NODE_ENV = 'test'
        SONARQUBE_SERVER = 'SonarQube'

        APP_CONTAINER = 'nestjs-app'
        APP_IMAGE = 'nestjs-app'
        APP_PORT = '3000'
        DOCKER_NETWORK = 'devops_network'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install dependencies') {
            steps {
                dir('nestest') {
                    sh 'node --version && npm --version'
                    sh 'npm pkg get devDependencies.typescript'
                    sh 'grep -A 3 node_modules/typescript package-lock.json'
                    sh 'npm ci'
                }
            }
        }

        stage('Lint') {
            steps {
                dir('nestest') {
                    sh 'npm run lint'
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir('nestest') {
                    sh 'npm test'
                }
            }
        }

        stage('Coverage') {
            steps {
                dir('nestest') {
                    sh 'npm run test:cov'
                }
            }
            post {
                always {
                    archiveArtifacts(
                        artifacts: 'nestest/coverage/**',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('nestest') {
                    script {
                        def scannerHome = tool 'SonarScanner'
                        withSonarQubeEnv("${SONARQUBE_SERVER}") {
                            sh "${scannerHome}/bin/sonar-scanner"
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build') {
            steps {
                dir('nestest') {
                    sh 'npm run build'
                }
            }
        }

        stage('Deploy') {
            when {
                expression {
                    def b = env.BRANCH_NAME ?: env.GIT_BRANCH ?: ''
                    return b == 'master' || b == 'origin/master'
                }
            }
            steps {
                withCredentials([file(credentialsId: 'app-env', variable: 'APP_ENV_FILE')]) {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail
                        docker info > /dev/null

                        echo ">>> Construyendo imagen ${APP_IMAGE}:${BUILD_NUMBER}"
                        docker build -f DockerFile -t "${APP_IMAGE}:${BUILD_NUMBER}" .

                        echo ">>> Reemplazando contenedor ${APP_CONTAINER}"
                        docker rm -f "${APP_CONTAINER}" || true
                        docker run -d \
                            --name "${APP_CONTAINER}" \
                            --restart unless-stopped \
                            --network "${DOCKER_NETWORK}" \
                            --publish "${APP_PORT}:${APP_PORT}" \
                            --env-file "${APP_ENV_FILE}" \
                            "${APP_IMAGE}:${BUILD_NUMBER}"

                        echo ">>> Despliegue completado"
                    '''
                }
            }
        }

        stage('Health Check') {
            when {
                expression {
                    def b = env.BRANCH_NAME ?: env.GIT_BRANCH ?: ''
                    return b == 'master' || b == 'origin/master'
                }
            }
            steps {
                sh '''
                    set -eu
                    HEALTH_URL="http://${APP_CONTAINER}:${APP_PORT}/health"
                    echo ">>> Verificando health check en ${HEALTH_URL}"

                    for i in $(seq 1 30); do
                        if curl --max-time 2 -sf "${HEALTH_URL}" > /dev/null 2>&1; then
                            echo ">>> Health check OK (intento ${i})"
                            curl --max-time 2 -s "${HEALTH_URL}"
                            exit 0
                        fi
                        echo ">>> Esperando... intento ${i}/30"
                        sleep 2
                    done

                    echo ">>> ERROR: Health check falló después de 30 intentos"
                    docker logs --tail 100 "${APP_CONTAINER}" || true
                    exit 1
                '''
            }
        }
    }

    post {
        always {
            junit(
                testResults: 'nestest/test-results/**/*.xml',
                allowEmptyResults: true
            )
        }
        success {
            echo 'Pipeline finalizado correctamente. Aplicación desplegada y saludable.'
        }
        failure {
            echo 'Pipeline fallido. Revisar la etapa que generó el error.'
        }
    }
}
